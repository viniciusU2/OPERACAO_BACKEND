# Exemplo de configuracao do backend (copie para .env e preencha).
# O arquivo .env NAO deve ser commitado.

# Banco de dados MySQL
DATABASE_URL=mysql+pymysql://usuario:senha@127.0.0.1:3306/manutencao

# Chave de assinatura dos tokens JWT (use uma string longa e aleatoria)
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# URL publica do frontend (usada em e-mails e redirecionamentos)
FRONTEND_URL=https://engvi.com.br

# SMTP (redefinicao de senha e notificacoes)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario@exemplo.com
SMTP_PASSWORD=troque-pela-senha-do-smtp
SMTP_FROM="ENGVI <usuario@exemplo.com>"
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Google OAuth (se utilizado)
CLIENT_ID=troque-pelo-client-id
CLIENT_SECRET=troque-pelo-client-secret

# Opcional: log das consultas SQL
SQLALCHEMY_ECHO=false

# Opcional: pastas e limites de fotos
# SS_FOTO_DIR=saida/ss/fotos
# SS_FOTO_MAX_MB=20
# SS_FOTO_MAX_LADO=1920
# INSPECAO_FOTO_DIR=saida/inspecoes/fotos
# INSPECAO_FOTO_MAX_MB=20
# INSPECAO_FOTO_MAX_LADO=1920
