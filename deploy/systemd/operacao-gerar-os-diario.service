[Unit]
Description=Geracao diaria das OS dos planos de manutencao
After=network-online.target operacao.service
Wants=network-online.target
Requires=operacao.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/OPERACAO_BACKEND
Environment=PYTHONUNBUFFERED=1
Environment=OPERACAO_GERAR_OS_URL=http://127.0.0.1:8000/os/gerar-os-planos
Environment=OPERACAO_GERAR_OS_TIMEOUT=3600
ExecStart=/root/OPERACAO_BACKEND/venv/bin/python /root/OPERACAO_BACKEND/scripts/gerar_os_planos_diario.py
Nice=10

[Install]
WantedBy=multi-user.target
